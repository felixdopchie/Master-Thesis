# Packages setting
if (!require(nleqslv)) install.packages("nleqslv", quiet = TRUE)
library(nleqslv)

# -----------------------------
# Calibration parameters 
# -----------------------------
b     <- 15      # Unemployment benefit
alpha <- 0.5     # Matching-function elasticity
y     <- 25      # Productivity
psi   <- 0.5     # Vacancy posting cost
d     <- 1       # Application cost
mu    <- 0.25    # Matching efficiency
xi    <- 0.9     # Share of disutility firms 

# -----------------------------
# Market-tightness under laissez-faire
# -----------------------------
theta_N_market <- ((mu * (1 - alpha) * (y - b)) / psi)^(1/alpha)
theta_M_market <- function(c) {
  numer <- y - b - c
  if (numer <= 0) return(0)
  ((mu * (1 - alpha) * numer) / psi)^(1/alpha)
}

# -----------------------------
# Utility of immigrants under laissez-faire
# -----------------------------
U_M_market <- function(c) {
  thM <- theta_M_market(c)
  pM  <- mu * thM^(1 - alpha)
  wM  <- y - (psi / mu) * thM^alpha - xi * c
  pM * wM + (1 - pM) * b - d
}

# -----------------------------
# Equal-Pay policy definitions
# -----------------------------
w_equal <- function(thN, thM, c) {
  denom <- thN^(1 - alpha) + thM^(1 - alpha)
  y - (thM^(1 - alpha)/denom)*xi*c -
    ((thN + thM)/(mu * denom))*psi
}

# FOCs for the 2×2 system under equal-pay (sees external c)
FOCs_factory <- function(c) {
  function(theta) {
    thN <- theta[1]; thM <- theta[2]
    w   <- w_equal(thN, thM, c)
    pN  <- mu * thN^(1 - alpha); dpN <- mu * (1 - alpha) * thN^(-alpha)
    pM  <- mu * thM^(1 - alpha); dpM <- mu * (1 - alpha) * thM^(-alpha)
    h   <- 1e-6
    dwN <- (w_equal(thN + h, thM, c) - w_equal(thN - h, thM, c)) / (2*h)
    dwM <- (w_equal(thN, thM + h, c) - w_equal(thN, thM - h, c)) / (2*h)
    F1  <- dpN * (w - b)            + pN * dwN
    F2  <- dpM * ((w - xi*c) - b)   + pM * dwM
    c(F1, F2)
  }
}

# Utility of immigrants under Equal-Pay (with safety checks)
U_M_equal <- function(c) {
  if (y - b - c < 0) return(b - d)
  sol <- try(
    nleqslv(c(theta_N_market, theta_M_market(c)),
            FOCs_factory(c)),
    silent = TRUE
  )
  if (inherits(sol, "try-error") || sol$termcd != 1) return(NA)
  thN <- sol$x[1]; thM <- sol$x[2]
  pM  <- mu * thM^(1 - alpha)
  w   <- w_equal(thN, thM, c)
  pM * w + (1 - pM) * b - d
}

# -----------------------------
# Compute utilities on a fine grid
# -----------------------------
c_vals    <- seq(0, 10, by = 0.2)
U_mkt_vec <- sapply(c_vals, U_M_market)
U_eq_vec  <- sapply(c_vals, U_M_equal)

# -----------------------------
# Plot only where U > 15
# -----------------------------
plot(c_vals, U_mkt_vec,
     type = "n",                          # set up axes only
     xlab = "Disutility parameter c",
     ylab = expression(U[M]),
     main = "Immigrant utility: Laissez-faire vs Equal-Pay",
     ylim = range(c(U_mkt_vec, U_eq_vec, 15), na.rm = TRUE))
abline(h = 15, lty = 3, col = "darkgreen")

# find the c-values where each series is above 15
idx_mkt <- which(U_mkt_vec > 15)
idx_eq  <- which(U_eq_vec  > 15)

# draw only those portions
lines(c_vals[idx_mkt], U_mkt_vec[idx_mkt],
      type = "b", pch = 16, lty = "33", col = "blue", cex = 0.6)
lines(c_vals[idx_eq],  U_eq_vec[idx_eq],
      type = "b", pch = 17, lty = "33", col = "red",  cex = 0.6)

legend("topright",
       legend = c("Laissez-faire", "Equal-Pay"),
